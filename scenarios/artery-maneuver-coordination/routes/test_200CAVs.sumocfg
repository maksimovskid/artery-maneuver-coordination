<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.sf.net/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="new_map.net.xml"/>
        <additional value="vehicle_types.xml"/>
        <!-- add here additional route files  -->

    <route-files value="test/merging_lane_1.rou.xml, test/highway_lane_0.rou.xml,test/highway_lane_1.rou.xml, test/highway_lane_2.rou.xml,
        test/added_routes/other_highway_lane_0.rou.xml, test/added_routes/other_highway_lane_1.rou.xml, test/added_routes/other_highway_lane_2.rou.xml,
        test/added_routes/other_2_highway_lane_0.rou.xml, test/added_routes/other_2_highway_lane_1.rou.xml, test/added_routes/other_2_highway_lane_2.rou.xml, 
        test/added_routes/highway_lane_0_2.rou.xml,  test/added_routes/highway_lane_1_2.rou.xml,  test/added_routes/highway_lane_2_2.rou.xml,  test/added_routes/highway_lane_0_2_2.rou.xml,
         test/added_routes/highway_lane_1_2_2.rou.xml,  test/added_routes/highway_lane_2_2_2.rou.xml"/>   
        <!-- above is with added vehicles on the highway up to 200 CAVs -->

    </input>

    <output>
		<!-- <summary-output value="../results_generated/test_200CAVs/simulation.summary.xml"/> -->
		<tripinfo-output value="../results_generated/test_200CAVs/simulation.tripinfo.xml"/>
		<statistic-output value="../results_generated/test_200CAVs/simulation.statistic.xml"/>
		<!-- <lanechange-output value="../results_generated/test_200CAVs/simulation.lane_change.xml"/>-->
		<!-- <collision-output value="../results_generated/test_200CAVs/simulation.collision.xml"/>-->
		<!-- <vehroute-output value="../results_generated/test_200CAVs/simulation.vehroute.xml"/>-->
		<!-- <lanedata-output value="../results_generated/test_200CAVs/simulation.lanedata.xml"/>-->
    <!--<edgedata-output value="../results_generated/test_200CAVs/simulation.edgedata.xml"/> -->
    </output>
	
    <time>
        <begin value="0"/>
        <step-length value="0.1"/>
        <end value="80.0"/>
    </time>
    
    <!-- <device.ssm.deterministic value="true"/> --> 
    <!-- <device.ssm.file value="../results_generated/test_200CAVs/simulation.ssm_vehicles.xml"/> -->

    <!-- <device.fcd.deterministic value="true"/>  --> 
    <!-- <fcd-output value="../results_generated/test_200CAVs/simulation.fcd_vehicles.xml"/>-->


        
</configuration>
