<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.sf.net/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="new_map.net.xml"/>
        <additional value="vehicle_types.xml"/>
        <!-- add here additional route files  -->
        <!-- <route-files value="test/highway_lane_0.rou.xml, test/highway_lane_1.rou.xml, test/highway_lane_2.rou.xml, test/merging_lane_1.rou.xml"/> -->
	 <route-files value="test/highway_lane_0.rou.xml, test/highway_lane_1.rou.xml, test/highway_lane_2.rou.xml, test/merging_lane_1.rou.xml,
        random_trips/randomroutes_p0001.rou.xml"/>  

    </input>

    <output>
		<!-- <summary-output value="../results_generated/test_random_trips/simulation.summary.xml"/> -->
		<tripinfo-output value="../results_generated/test_random_trips/simulation.tripinfo.xml"/>
		<statistic-output value="../results_generated/test_random_trips/simulation.statistic.xml"/>
		<!-- <lanechange-output value="../results_generated/test_random_trips/simulation.lane_change.xml"/>-->
		<!-- <collision-output value="../results_generated/test_random_trips/simulation.collision.xml"/>-->
