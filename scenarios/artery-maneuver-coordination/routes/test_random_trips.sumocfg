		<!-- <lanedata-output value="../results_generated/test_random_trips/simulation.lanedata.xml"/>-->
    <!--<edgedata-output value="../results_generated/test_random_trips/simulation.edgedata.xml"/> -->
    </output>
	
    <time>
        <begin value="0"/>
        <step-length value="0.1"/>
        <end value="80.0"/>
    </time>
    
